# Music provider adapter (server-side only)
# Example:
# MUSIC_API_BASE_URL=https://api.your-music-provider.com/v1
# MUSIC_API_KEY=replace-with-your-secret-key
#
# Provider must return JSON containing tracks/results/data:
# [{ id, title, artist, album, coverUrl, streamUrl, durationSeconds, genre }]
# streamUrl/previewUrl must be a browser-playable HTTPS audio URL.
#
# Optional endpoint configuration:
MUSIC_API_BASE_URL=
MUSIC_API_KEY=
MUSIC_API_SEARCH_PATH=/search
MUSIC_API_RELATED_PATH=/tracks/{id}/related
MUSIC_API_AUTH_HEADER=Authorization
MUSIC_API_AUTH_PREFIX=Bearer
